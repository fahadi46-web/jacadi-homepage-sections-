<section class="services" {{ section.shopify_attributes }}>
  {% for block in section.blocks %}
    <div class="service" {{ block.shopify_attributes }}>
      {% if block.settings.icon %}
        <img
          src="{{ block.settings.icon | image_url: width: 80 }}"
          alt="{{ block.settings.icon.alt | default: block.settings.title | escape }}"
          width="40"
          height="40"
          loading="lazy"
        >
      {% endif %}
      {% if block.settings.title != blank %}
        <h4 class="service__title">{{ block.settings.title }}</h4>
      {% endif %}
      {% if block.settings.text != blank %}
        <p class="service__text">{{ block.settings.text }}</p>
      {% endif %}
    </div>
  {% endfor %}
</section>

<style>
.services {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  gap: 24px;
  padding: 40px 20px;
  background: #f7f7f7;
}
.service {
  flex: 1 1 120px;
  max-width: 200px;
  text-align: center;
}
.service img {
  width: 40px;
  height: 40px;
  object-fit: contain;
  margin-bottom: 10px;
}
.service__title {
  margin: 0 0 6px;
  font-size: 0.95rem;
  font-weight: 600;
}
.service__text {
  margin: 0;
  font-size: 0.85rem;
  color: #555;
}
</style>

{% schema %}
{
  "name": "Services Icons",
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [{ "name": "Services Icons" }]
}
{% endschema %}
