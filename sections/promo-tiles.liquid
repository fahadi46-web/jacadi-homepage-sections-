<section class="promo-tiles" {{ section.shopify_attributes }}>
  {% for block in section.blocks %}
    <a href="{{ block.settings.link }}" class="promo-tile" {{ block.shopify_attributes }}>
      {% if block.settings.image %}
        <div class="promo-tile__img-wrap">
          <img
            src="{{ block.settings.image | image_url: width: 600 }}"
            alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
            loading="lazy"
            width="600"
          >
        </div>
      {% endif %}
      {% if block.settings.title != blank %}
        <h3 class="promo-tile__title">{{ block.settings.title }}</h3>
      {% endif %}
    </a>
  {% endfor %}
</section>

<style>
.promo-tiles {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
  padding: 40px 20px;
}
.promo-tile {
  display: block;
  text-decoration: none;
  color: inherit;
  overflow: hidden;
}
.promo-tile__img-wrap {
  overflow: hidden;
}
.promo-tile__img-wrap img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 0.3s ease;
}
.promo-tile:hover .promo-tile__img-wrap img {
  transform: scale(1.04);
}
.promo-tile__title {
  margin: 10px 0 0;
  font-size: 1rem;
  text-align: center;
}
</style>

{% schema %}
{
  "name": "Promo Tiles",
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Promo Tiles" }]
}
{% endschema %}
